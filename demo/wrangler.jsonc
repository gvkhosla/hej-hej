{
  "name": "hej-hej-offline-demo",
  "main": "../src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "ASSISTANT",
        "class_name": "Assistant",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Assistant"],
    },
  ],
  "vars": {
    "DEMO_MODE": "true",
    "ADMIN_TOKEN": "hej-hej-offline-demo-admin-not-for-deployment",
    "BRIDGE_TOKEN": "hej-hej-offline-demo-bridge-not-for-deployment",
    "TOKEN_KEY": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
    "PUBLIC_URL": "http://127.0.0.1",
    "OWNER_EMAIL": "demo@example.com",
    "MODEL_ID": "unused-in-demo",
    "WHATSAPP_GRAPH_VERSION": "v23.0",
  },
  "observability": {
    "enabled": false,
  },
}
