# These are examples, never usable credentials.
# Worker local secrets: copy relevant variables into .dev.vars, not a committed file.
ADMIN_TOKEN=GENERATE_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
BRIDGE_TOKEN=GENERATE_A_DIFFERENT_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
TOKEN_KEY=GENERATE_BASE64_OF_32_RANDOM_BYTES
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TAVILY_API_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_OWNER=
WHATSAPP_PHONE_ID=
WHATSAPP_BUSINESS_ID=

# Mac bridge environment only (not Worker secrets)
ASSISTANT_URL=https://YOUR-WORKER.workers.dev
IMESSAGE_OWNER=+15551234567
IMESSAGE_SERVICE_ID=
# MESSAGES_DB defaults to ~/Library/Messages/chat.db
# BRIDGE_STATE_DIR defaults to ~/.local/state/pi-assistant
